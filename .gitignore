```
# Rust-specific ignores
target/
Cargo.lock

# Dependencies
vendor/

# Logs and temp files
*.log
*.tmp

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Coverage
coverage/
htmlcov/
.coverage

# Python-related (if any mixed projects)
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Build artifacts
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.out

# Archives
*.zip
*.tar.gz
*.tar.xz
*.tar.bz2
*.gz
*.rar
*.7z
```